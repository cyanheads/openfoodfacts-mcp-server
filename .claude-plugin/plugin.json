{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "openfoodfacts-mcp-server",
  "version": "0.3.2",
  "description": "Look up food products by barcode, search by ingredient or nutrition filter, compare products side-by-side, and browse the canonical tag vocabulary via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/openfoodfacts-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/openfoodfacts-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": [
    "openfoodfacts",
    "food",
    "nutrition",
    "barcode",
    "nutriscore",
    "nova",
    "ingredients",
    "allergens",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "mcpServers": {
    "openfoodfacts-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/openfoodfacts-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
